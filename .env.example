# Contraseña para entrar a /admin
ADMIN_PASSWORD=cambia-esta-contraseña
# Clave para firmar la sesión (mínimo 32 caracteres). Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Número de WhatsApp: código de país + número, solo dígitos
WHATSAPP_NUMBER=573000000000
# Carpeta donde se guardan las fotos (debe ser un disco persistente en producción)
STORAGE_DIR=./storage
