# Copy to /etc/monte-y-cielo-web.env on the server (chmod 600, owned by root) — see deploy/README.md.
# systemd reads it as root before dropping to the monteycielo user.

# Password for /admin
ADMIN_PASSWORD=
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Country code + number, digits only. Keep in sync with the WHATSAPP_NUMBER GitHub variable.
WHATSAPP_NUMBER=
# Persistent photo storage, outside the releases. Must match REMOTE_STORAGE in deploy.yml.
STORAGE_DIR=/opt/monte-y-cielo-web/storage
